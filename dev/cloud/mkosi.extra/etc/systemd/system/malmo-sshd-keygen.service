# Hosted cloud image — make sure sshd has host keys before it ever starts. #467.
#
# Two problems this solves, and neither is visible until a box is weeks old.
#
# 1. The keys must not be baked. Debian's openssh-server postinst runs
#    `ssh-keygen -A` at install time, which on an image build means every box
#    provisioned from that image ships the SAME host keys — anyone holding the
#    published image could impersonate any hosted box to its owner's ssh client.
#    mkosi.postinst.chroot deletes them for that reason, the same way it leaves
#    /etc/machine-id empty.
#
# 2. Debian's own sshd-keygen.service cannot replace them. It is
#    ConditionFirstBoot=yes and WantedBy=ssh.service, so it only runs when
#    ssh.service starts ON THE VERY FIRST BOOT. On this profile sshd is stopped
#    until an account opts in (BUILD.md # SSH), which is usually not the first
#    boot and may be months later — by then the condition is false, the unit is
#    skipped, and sshd exits with "no hostkeys available".
#
# So: same job, no first-boot condition. Pulled in by ssh.service, so it runs on
# whichever boot the account toggle first starts the daemon, and never otherwise.
# `ssh-keygen -A` only creates the keys that are missing, so later starts are
# no-ops and an existing box's keys are never rotated underneath it.
[Unit]
Description=malmo — generate sshd host keys if they are missing
Documentation=https://github.com/malmoos/malmo/blob/main/docs/specs/BUILD.md
Before=ssh.service
ConditionPathIsReadWrite=/etc/ssh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=ssh.service
